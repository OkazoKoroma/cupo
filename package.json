{
  "name": "widget-uso-claude",
  "version": "0.1.0",
  "description": "Cupo: widget de escritorio para Windows que muestra el uso de tu plan de Claude y avisa antes de pasarte del límite",
  "author": "Usuario",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "cl.widget-uso-claude",
    "productName": "Cupo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icono.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Instalar-Cupo-${version}.exe",
      "deleteAppDataOnUninstall": false
    }
  }
}
